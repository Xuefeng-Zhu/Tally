# Local fixture mode. No credentials are required.
TALLY_EXECUTION_MODE=fixture
TALLY_LOCAL_PORT=4318
TALLY_DATA_PATH=.data/state.json
LIVE_PROVIDERS_ENABLED=false
TALLY_APPROVED_LIVE_FLOW=false
TALLY_DEMO_TENANT_ID=demo-bakery-001
TALLY_TAX_YEAR=2025
TALLY_RULE_SET_ID=us-federal-irc45r-2025-v1

# Browser QA overrides (optional; use a fresh isolated API state).
# TALLY_WEB_URL=http://127.0.0.1:5173
# TALLY_API_URL=http://127.0.0.1:4318
# TALLY_ARTIFACTS_DIR=.artifacts/browser

# Live gates are unrun and require separate explicit approval.
# Do not paste credentials into this file or commit a .env file.
# Existing approved credentials must be injected through the environment.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.openai.gpt-6-luna
# TALLY_EXPLANATION_ADAPTER=strands
# TALLY_SMOKE_INPUT_PATH=fixtures/interim/strands-smoke-input.json
# Source is explicitly reconstructed synthetic input; no original smoke file was read.
# TALLY_API_ORIGIN=https://<approved-api-id>.execute-api.us-east-1.amazonaws.com
# TALLY_APPROVED_LIVE_FLOW must remain unset until the whole live application flow is approved.
# BOX_INPUT_FOLDER_ID=
# BOX_FIXTURE_A_FILE_ID=
# BOX_EXPECTED_USER_ID=
# BOX_WEBHOOK_ID=
# Secret values (BOX_ACCESS_TOKEN, BOX_WEBHOOK_PRIMARY_KEY,
# BOX_WEBHOOK_SECONDARY_KEY) intentionally have no example assignments.
# Deployed configuration uses BOX_CREDENTIALS_SECRET_ARN and
# BOX_WEBHOOK_SIGNATURES_SECRET_ARN; no secret is created by the local demo.

# Explicit named existing secrets (ARNs only, no secret contents):
# BOX_CREDENTIALS_SECRET_ARN=
# BOX_WEBHOOK_SIGNATURES_SECRET_ARN=
# TALLY_TABLE_NAME=
# TALLY_QUEUE_URL=
# Optional isolated local review session:
# TALLY_WEB_ORIGIN=http://127.0.0.1:5174
# TALLY_WEB_PORT=5174
# TALLY_API_PROXY_TARGET=http://127.0.0.1:4319
