{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx apps/local-proxy/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config apps/web/vite.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "smoke:box": "tsx scripts/smoke-box.ts",
    "smoke:strands": "tsx scripts/smoke-strands.ts",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "check:infra": "node infra/check-template.mjs"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@aws-sdk/credential-provider-node": "3.972.86",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@smithy/signature-v4": "5.3.3",
    "@strands-agents/sdk": "1.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "node": "22.23.3",
    "playwright": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
